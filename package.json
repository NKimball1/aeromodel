{
  "name": "aeromodel",
  "private": true,
  "packageManager": "pnpm@12.4.1",
  "version": "0.1.0",
  "description": "Interactive 3D cycling aerodynamics: see how position, kit and equipment change watts, speed and the wake.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "ref": "vitest run --config vitest.scripts.config.ts"
  },
  "dependencies": {
    "lil-gui": "^0.21.0",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@types/three": "^0.170.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.0"
  }
}
